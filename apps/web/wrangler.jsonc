// appmarket.org web Worker: Angular hybrid rendering (SSR for SEO pages, client rendering for the app).
// Built with `ng build`; uses Wrangler because Angular builds outside the Vite plugin that `cf` uses.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "appmarket-web",
	"main": "./dist/server/server.mjs",
	"compatibility_date": "2026-10-01",
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/browser",
		// Serve /legal/privacy without redirecting to /legal/privacy/, matching canonical URLs.
		"html_handling": "drop-trailing-slash"
	},
	// R23: logs and Issues; query strings stripped from logged URLs (OAuth codes, signed links).
	"observability": { "enabled": true, "redact_query_string": true, "issues": { "enabled": true } },
	"upload_source_maps": true,
	// /api/*, /sitemap.xml and SSR data fetches go to the API Worker without a public hop.
	"services": [{ "binding": "API", "service": "appmarket-api" }],
	// R22: custom domains (Cloudflare creates the DNS records and certificates on deploy).
	"routes": [{ "pattern": "appmarket.org", "custom_domain": true }],
	// PRD R4: top level is production; `wrangler deploy --env staging` targets the staging API.
	"env": {
		"staging": {
			"name": "appmarket-web-staging",
			"services": [{ "binding": "API", "service": "appmarket-api-staging" }],
			"routes": [{ "pattern": "staging.appmarket.org", "custom_domain": true }]
		}
	}
}
