# Copy to .dev.vars (git-ignored) for `cf dev`. Never commit real values.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Redirect URI: http://localhost:4200/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub > Settings > Developer settings > OAuth Apps.
# Callback URL: http://localhost:4200/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Turnstile test secret that always passes (Cloudflare published test key); use a real key outside dev.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Signs download links (R14). Generate: openssl rand -base64 32
DOWNLOAD_SIGNING_KEY=
# Cloudflare OAuth client for "Connect your Cloudflare account" (D5). Create it under
# Manage Account > OAuth clients (see docs/cloudflare-deploy.md). Redirect URL for local dev:
# http://localhost:4200/api/cloudflare/callback
CF_OAUTH_CLIENT_ID=
CF_OAUTH_CLIENT_SECRET=
# Encrypts buyers' Cloudflare tokens at rest. Generate: openssl rand -base64 32
CF_TOKEN_ENCRYPTION_KEY=
