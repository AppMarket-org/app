{
  "name": "appmarket",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --parallel --filter @appmarket/api --filter @appmarket/web dev",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "build": "pnpm --filter @appmarket/web --filter appmarket --filter @appmarket/docs build",
    "test": "pnpm --filter @appmarket/shared --filter @appmarket/template-contract --filter @appmarket/api --filter appmarket test && pnpm --filter @appmarket/web exec ng test --watch=false",
    "check:ui": "node scripts/check-ui.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
